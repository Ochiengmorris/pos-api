
DATABASE_URL="postgresql://pos:pos@localhost:5438/pos_test?schema=public"
JWT_SECRET="test-secret-test-secret-test-secret-123"
JWT_EXPIRES_IN="1h"
RECEIPT_PREFIX="RCP"
BUSINESS_TZ="Africa/Nairobi"
MPESA_CALLBACK_SECRET="test-callback-secret"
MPESA_ALLOW_MANUAL_REFERENCE="false"
THROTTLE_DISABLED="true"

# eTIMS: "disabled" (default, nothing changes), "mock" (development), later "oscu"
ETIMS_PROVIDER=mock
ETIMS_TIN=A123456789Z          # your KRA PIN (this value is KRA's sample PIN, fine for the mock only)
ETIMS_WORKER=off                # off in tests
