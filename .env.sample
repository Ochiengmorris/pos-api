DATABASE_URL="postgresql://pos:pos@localhost:5438/pos?schema=public"
JWT_SECRET=""
JWT_EXPIRES_IN="12h"

SEED_ADMIN_EMAIL="admin@shop.local"
SEED_ADMIN_PASSWORD="ChangeME123!"

RECEIPT_PREFIX="RCP"
STORE_NAME="Niko Stores"
STORE_ADDRESS=""
STORE_PHONE="+254700000000"
STORE_TAX_PIN="KRAI123456789"

MPESA_ENV=sandbox                      # sandbox | production
MPESA_CONSUMER_KEY=""
MPESA_CONSUMER_SECRET=""
MPESA_SHORTCODE=
MPESA_PASSKEY=""
MPESA_TRANSACTION_TYPE="CustomerPayBillOnline"   # CustomerBuyGoodsOnline for a Till
MPESA_PARTY_B=
MPESA_CALLBACK_BASE_URL=""  # public HTTPS, no trailing slash
MPESA_CALLBACK_SECRET=""
MPESA_VERIFY_CALLBACKS=false    # remember to make it true in prod 
MPESA_ALLOW_MANUAL_REFERENCE=false

BUSINESS_TZ=

FRONTEND_ORIGIN=http://localhost:3000
TRUST_PROXY=false    # make it true if serving through nginx, Caddy or a load balancer

ENABLE_DOCS=true # false in production

# eTIMS: "disabled" (default, nothing changes), "mock" (development), later "oscu"
ETIMS_PROVIDER=mock
ETIMS_TIN=A123456789Z          # your KRA PIN (this value is KRA's sample PIN, fine for the mock only)
ETIMS_BHF_ID=00
ETIMS_TAXBL_BASIS=inclusive    # inclusive (KRA sample) | exclusive
ETIMS_FIRST_INVOICE_NO=1
ETIMS_MAX_ATTEMPTS=20
ETIMS_WORKER=on                # off in tests
ETIMS_QR_URL_TEMPLATE=         # fill in from KRA's TIS specification; see the notes in phase E2
MOCK_ETIMS_MODE=ok
ETIMS_STUCK_MINUTES=15          # an invoice still unsent after this long raises an alert
ETIMS_ALERT_WEBHOOK_URL=        # optional: receives {"text": "..."} (Slack-compatiblew)


STOCK_COUNT_APPROVAL_VALUE=20000   # total difference at cost (KSh) above which an administrator must approve

CASH_REQUIRE_SHIFT=true          # no sales without an open shift (leave unset or false in tests)
CASH_PAID_OUT_LIMIT=2000         # above this, only a manager can record a paid-out
CASH_VARIANCE_TOLERANCE=100      # a difference beyond this needs a note and a manager's review
CASH_STALE_SHIFT_HOURS=        # warn the cashier when a shift has been open this long

C2B_ENABLED=
C2B_CALLBACK_TOKEN=
C2B_SHORTCODE=
C2B_TILL_NUMBER=