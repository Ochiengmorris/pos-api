generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  MANAGER
  CASHIER
}

enum MpesaStatus {
  PENDING
  SUCCESS
  FAILED
  CANCELLED
  TIMEOUT
}

enum SaleStatus {
  COMPLETED
  VOIDED
  REFUNDED
}

enum PaymentMethod {
  CASH
  MPESA
  CARD
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
}

enum StockMovementType {
  PURCHASE
  SALE
  ADJUSTMENT
  RETURN
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  role         Role     @default(CASHIER)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  sales          Sale[]
  stockMovements StockMovement[]
  mpesaPayments  MpesaPayment[]
}

model Category {
  id        String    @id @default(cuid())
  name      String    @unique
  createdAt DateTime  @default(now())
  products  Product[]
}

model Product {
  id           String   @id @default(cuid())
  sku          String   @unique
  barcode      String?  @unique
  name         String
  categoryId   String?
  price        Decimal  @db.Decimal(12, 2)
  costPrice    Decimal  @default(0) @db.Decimal(12, 2)
  taxRate      Decimal  @default(0) @db.Decimal(5, 2)
  stockQty     Int      @default(0)
  reorderLevel Int      @default(5)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  category       Category?       @relation(fields: [categoryId], references: [id])
  saleItems      SaleItem[]
  stockMovements StockMovement[]

  @@index([name])
  @@index([categoryId])
}

model Customer {
  id        String   @id @default(cuid())
  name      String
  phone     String?  @unique
  email     String?
  createdAt DateTime @default(now())
  sales     Sale[]
}

model Sale {
  id            String     @id @default(cuid())
  receiptNumber Int        @unique @default(autoincrement())
  cashierId     String
  customerId    String?
  status        SaleStatus @default(COMPLETED)
  subtotal      Decimal    @db.Decimal(12, 2)
  taxTotal      Decimal    @default(0) @db.Decimal(12, 2)
  discountTotal Decimal    @default(0) @db.Decimal(12, 2)
  total         Decimal    @db.Decimal(12, 2)
  createdAt     DateTime   @default(now())

  cashier        User            @relation(fields: [cashierId], references: [id])
  customer       Customer?       @relation(fields: [customerId], references: [id])
  items          SaleItem[]
  payments       Payment[]
  stockMovements StockMovement[]
  mpesaPayments  MpesaPayment[]

  clientRequestId String?   @unique // idempotency key from the client
  voidedAt        DateTime?
  voidReason      String?
  voidedById      String?

  @@index([createdAt])
  @@index([cashierId])
  @@index([status, createdAt])
}

model SaleItem {
  id          String  @id @default(cuid())
  saleId      String
  productId   String
  productName String // snapshot, so history survives renames
  quantity    Int
  unitPrice   Decimal @db.Decimal(12, 2)
  unitCost    Decimal @db.Decimal(12, 2)
  taxAmount   Decimal @default(0) @db.Decimal(12, 2)
  lineTotal   Decimal @db.Decimal(12, 2)
  taxRate     Decimal @default(0) @db.Decimal(5, 2)

  sale    Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@index([saleId])
  @@index([productId])
}

model Payment {
  id        String        @id @default(cuid())
  saleId    String
  method    PaymentMethod
  status    PaymentStatus @default(PENDING)
  amount    Decimal       @db.Decimal(12, 2)
  reference String? // e.g. M-Pesa receipt code
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  sale Sale @relation(fields: [saleId], references: [id], onDelete: Cascade)

  tendered Decimal? @db.Decimal(12, 2) // cash handed over
  change   Decimal? @db.Decimal(12, 2) // cash given back

  @@unique([method, reference])
  @@index([saleId])
}

model MpesaPayment {
  id                String      @id @default(cuid())
  cashierId         String
  phone             String
  amount            Decimal     @db.Decimal(12, 2)
  status            MpesaStatus @default(PENDING)
  merchantRequestId String?
  checkoutRequestId String?     @unique
  receipt           String?     @unique // M-Pesa receipt code
  resultCode        Int?
  resultDesc        String?
  saleId            String? // set when a sale claims this payment
  lastCheckedAt     DateTime?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  cashier User  @relation(fields: [cashierId], references: [id])
  sale    Sale? @relation(fields: [saleId], references: [id])

  @@index([status, createdAt])
  @@index([cashierId])
  @@index([saleId])
}

model StockMovement {
  id        String            @id @default(cuid())
  productId String
  type      StockMovementType
  quantity  Int // signed: negative = stock out
  reason    String?
  userId    String?
  saleId    String?
  createdAt DateTime          @default(now())

  product Product @relation(fields: [productId], references: [id])
  user    User?   @relation(fields: [userId], references: [id])
  sale    Sale?   @relation(fields: [saleId], references: [id])

  @@index([productId, createdAt])
}
