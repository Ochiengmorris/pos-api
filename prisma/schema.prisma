// generator client {
//   provider = "prisma-client"
//   output   = "../generated/prisma"
// }

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  MANAGER
  CASHIER
}

enum MpesaStatus {
  PENDING
  SUCCESS
  FAILED
  CANCELLED
  TIMEOUT
}

enum MpesaResolution {
  REFUNDED
  WRITTEN_OFF
}

enum SaleStatus {
  COMPLETED
  VOIDED
  REFUNDED
}

enum PaymentMethod {
  CASH
  MPESA
  CARD
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
}

enum StockMovementType {
  PURCHASE
  SALE
  ADJUSTMENT
  RETURN
}

enum TaxTypeCode {
  A
  B
  C
  D
  E
}

enum TaxInvoiceType {
  SALE
  CREDIT_NOTE
}

enum TaxInvoiceStatus {
  PENDING
  ACCEPTED
  REJECTED
  FAILED
  UNCERTAIN
  CANCELLED
}

enum EtimsJobStatus {
  QUEUED
  RUNNING
  RETRY
  DONE
  FAILED
  UNCERTAIN
  CANCELLED
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  role         Role     @default(CASHIER)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  mustChangePassword Boolean @default(false)

  sales          Sale[]
  stockMovements StockMovement[]
  mpesaPayments  MpesaPayment[]
}

model Category {
  id        String    @id @default(cuid())
  name      String    @unique
  createdAt DateTime  @default(now())
  products  Product[]
}

model Product {
  id           String   @id @default(cuid())
  sku          String   @unique
  barcode      String?  @unique
  name         String
  categoryId   String?
  price        Decimal  @db.Decimal(12, 2)
  costPrice    Decimal  @default(0) @db.Decimal(12, 2)
  taxRate      Decimal  @default(0) @db.Decimal(5, 2)
  stockQty     Int      @default(0)
  reorderLevel Int      @default(5)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  category       Category?       @relation(fields: [categoryId], references: [id])
  saleItems      SaleItem[]
  stockMovements StockMovement[]

  taxTyCd        TaxTypeCode @default(B)
  taxConfirmed   Boolean     @default(false) // the owner/accountant has reviewed this product's VAT class
  etimsSeq       Int         @unique @default(autoincrement())
  etimsItemClsCd String? // KRA item classification (needed for live item registration)
  pkgUnitCd      String      @default("NT")
  qtyUnitCd      String      @default("U")

  @@index([name])
  @@index([categoryId])
}

model Customer {
  id        String   @id @default(cuid())
  name      String
  phone     String?  @unique
  email     String?
  createdAt DateTime @default(now())
  sales     Sale[]
}

model Sale {
  id            String     @id @default(cuid())
  receiptNumber Int        @unique @default(autoincrement())
  cashierId     String
  customerId    String?
  status        SaleStatus @default(COMPLETED)
  subtotal      Decimal    @db.Decimal(12, 2)
  taxTotal      Decimal    @default(0) @db.Decimal(12, 2)
  discountTotal Decimal    @default(0) @db.Decimal(12, 2)
  total         Decimal    @db.Decimal(12, 2)
  createdAt     DateTime   @default(now())

  cashier        User            @relation(fields: [cashierId], references: [id])
  customer       Customer?       @relation(fields: [customerId], references: [id])
  items          SaleItem[]
  payments       Payment[]
  stockMovements StockMovement[]
  mpesaPayments  MpesaPayment[]

  clientRequestId String?      @unique // idempotency key from the client
  voidedAt        DateTime?
  voidReason      String?
  voidedById      String?
  taxInvoices     TaxInvoice[]

  @@index([createdAt])
  @@index([cashierId])
  @@index([status, createdAt])
}

model SaleItem {
  id          String  @id @default(cuid())
  saleId      String
  productId   String
  productName String // snapshot, so history survives renames
  quantity    Int
  unitPrice   Decimal @db.Decimal(12, 2)
  unitCost    Decimal @db.Decimal(12, 2)
  taxAmount   Decimal @default(0) @db.Decimal(12, 2)
  lineTotal   Decimal @db.Decimal(12, 2)
  taxRate     Decimal @default(0) @db.Decimal(5, 2)

  sale    Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  taxTyCd TaxTypeCode @default(B)

  @@index([saleId])
  @@index([productId])
}

model Payment {
  id        String        @id @default(cuid())
  saleId    String
  method    PaymentMethod
  status    PaymentStatus @default(PENDING)
  amount    Decimal       @db.Decimal(12, 2)
  reference String? // e.g. M-Pesa receipt code
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  sale Sale @relation(fields: [saleId], references: [id], onDelete: Cascade)

  tendered Decimal? @db.Decimal(12, 2) // cash handed over
  change   Decimal? @db.Decimal(12, 2) // cash given back

  @@unique([method, reference])
  @@index([saleId])
}

model MpesaPayment {
  id                String      @id @default(cuid())
  cashierId         String
  phone             String
  amount            Decimal     @db.Decimal(12, 2)
  status            MpesaStatus @default(PENDING)
  merchantRequestId String?
  checkoutRequestId String?     @unique
  receipt           String?     @unique // M-Pesa receipt code
  resultCode        Int?
  resultDesc        String?
  saleId            String? // set when a sale claims this payment
  lastCheckedAt     DateTime?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  cashier User  @relation(fields: [cashierId], references: [id])
  sale    Sale? @relation(fields: [saleId], references: [id])

  resolution     MpesaResolution?
  resolutionNote String?
  resolvedAt     DateTime?
  resolvedById   String?

  @@index([status, createdAt])
  @@index([cashierId])
  @@index([saleId])
}

model StockMovement {
  id        String            @id @default(cuid())
  productId String
  type      StockMovementType
  quantity  Int // signed: negative = stock out
  reason    String?
  userId    String?
  saleId    String?
  createdAt DateTime          @default(now())

  product Product @relation(fields: [productId], references: [id])
  user    User?   @relation(fields: [userId], references: [id])
  sale    Sale?   @relation(fields: [saleId], references: [id])

  @@index([productId, createdAt])
}

model StoreSettings {
  id            String   @id @default("store")
  name          String
  address       String   @default("")
  phone         String   @default("")
  taxPin        String   @default("")
  receiptFooter String   @default("Thank you for shopping with us!")
  updatedAt     DateTime @updatedAt
  updatedById   String?
}

// the five KRA tax classes and their rates (editable here, never hardcoded in calculations)
model TaxType {
  code        TaxTypeCode @id
  name        String
  rate        Decimal     @db.Decimal(5, 2)
  updatedAt   DateTime    @updatedAt
  updatedById String?
}

model TaxInvoice {
  id                String           @id @default(cuid())
  saleId            String
  type              TaxInvoiceType   @default(SALE)
  internalNo        String           @unique
  status            TaxInvoiceStatus @default(PENDING)
  environment       String // MOCK | SANDBOX | PRODUCTION: which provider handled it
  originalInvoiceId String? // for credit notes
  invcNo            Int? // KRA invoice number, assigned at first transmission
  customerPin       String?
  customerName      String?
  payload           Json // the request body (no credentials), kept for audit and retries

  // returned by KRA on acceptance
  receiptNo            Int?
  totalReceiptNo       Int?
  intrlData            String?
  rcptSign             String?
  sdcId                String?
  mrcNo                String?
  sdcDateTime          String?
  qrPayload            String?
  manuallyResolvedAt   DateTime?
  manuallyResolvedById String?

  submittedAt      DateTime?
  acceptedAt       DateTime?
  lastAttemptAt    DateTime?
  attemptCount     Int       @default(0)
  lastErrorCode    String?
  lastErrorMessage String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  sale   Sale         @relation(fields: [saleId], references: [id])
  job    EtimsJob?
  events EtimsEvent[]

  officialPrintCount Int @default(0) // times the accepted invoice has been printed; later prints are labelled COPY

  @@unique([saleId, type])
  @@index([status, createdAt])
}

model EtimsJob {
  id             String         @id @default(cuid())
  invoiceId      String         @unique
  idempotencyKey String         @unique
  status         EtimsJobStatus @default(QUEUED)
  attempts       Int            @default(0)
  nextAttemptAt  DateTime       @default(now())
  lockedUntil    DateTime?
  sentAt         DateTime? // set before a request goes out: if present, the outcome may be unknown
  lastError      String?
  correlationId  String
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  invoice TaxInvoice @relation(fields: [invoiceId], references: [id])

  @@index([status, nextAttemptAt])
}

// audit trail: every state change, retry and manual action
model EtimsEvent {
  id            String   @id @default(cuid())
  invoiceId     String
  type          String
  message       String?
  data          Json?
  actorId       String?
  correlationId String?
  createdAt     DateTime @default(now())

  invoice TaxInvoice @relation(fields: [invoiceId], references: [id])

  @@index([invoiceId, createdAt])
}

model EtimsSequence {
  tin    String
  bhfId  String
  nextNo Int

  @@id([tin, bhfId])
}

// who changed what, for anything tax-relevant
model AuditLog {
  id        String   @id @default(cuid())
  entity    String // "TaxType", "Product"
  entityId  String
  action    String // "RATE_CHANGED", "TAX_CLASS_CHANGED", "TAX_CLASS_CONFIRMED"
  before    Json?
  after     Json?
  actorId   String?
  createdAt DateTime @default(now())

  @@index([entity, entityId, createdAt])
}
